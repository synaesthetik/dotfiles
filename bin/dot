#!/usr/bin/env bash
set -euo pipefail

# dot -- dependency-free management CLI for this dotfiles repo. Kept
# /bin/bash-3.2-safe (plain `case` dispatch, indexed args only -- no
# bash-4+-only constructs) so it never depends on a Homebrew-installed
# bash -- see 03-RESEARCH.md Pattern 3 for the full incompatible-construct
# list.
#
# The two-target stow logic in dot_stow (zsh/git -> $HOME; claude ->
# $HOME/.claude with a mkdir -p guard) is moved verbatim from bootstrap.sh,
# not re-derived: a single `-t "$HOME"` call for all three packages was
# proven broken (stray ~/CLAUDE.md, ~/settings.json, ~/skills) -- see
# 02-03-SUMMARY.md.

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

dot_stow() {
  local pkg="${1:-}"

  case "$pkg" in
    zsh)
      stow --no-folding -t "$HOME" -d "$REPO_DIR" zsh
      ;;
    git)
      stow --no-folding -t "$HOME" -d "$REPO_DIR" git
      ;;
    claude)
      mkdir -p "$HOME/.claude"
      stow --no-folding -t "$HOME/.claude" -d "$REPO_DIR" claude
      ;;
    "")
      stow --no-folding -t "$HOME" -d "$REPO_DIR" zsh git
      mkdir -p "$HOME/.claude"
      stow --no-folding -t "$HOME/.claude" -d "$REPO_DIR" claude
      ;;
    *)
      echo "dot: unknown package '$pkg' (expected zsh, git, or claude)" >&2
      exit 1
      ;;
  esac
}

dot_install() {
  if ! command -v brew >/dev/null 2>&1; then
    echo "dot: Homebrew not found. Run ./bootstrap.sh first." >&2
    exit 1
  fi

  brew bundle --file="$REPO_DIR/Brewfile"
  dot_stow
}

dot_update() {
  if [ -n "$(git -C "$REPO_DIR" status --porcelain)" ]; then
    echo "dot: working tree has uncommitted changes -- commit or stash your changes first, then re-run" >&2
    exit 1
  fi

  git -C "$REPO_DIR" pull

  if ! command -v brew >/dev/null 2>&1; then
    echo "dot: Homebrew not found. Run ./bootstrap.sh first." >&2
    exit 1
  fi

  brew bundle --file="$REPO_DIR/Brewfile"

  stow -R --no-folding -t "$HOME" -d "$REPO_DIR" zsh git
  mkdir -p "$HOME/.claude"
  stow -R --no-folding -t "$HOME/.claude" -d "$REPO_DIR" claude
}

dot_doctor() {
  local fix=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --fix) fix=1; shift ;;
      -*) echo "dot: unknown flag '$1'" >&2; exit 1 ;;
      *) shift ;;
    esac
  done

  local unresolved=0
  local entry pkg target file rel dest link_target
  local -a broken_pkgs=()

  for entry in "zsh:$HOME" "git:$HOME" "claude:$HOME/.claude"; do
    pkg="${entry%%:*}"
    target="${entry#*:}"

    while IFS= read -r file; do
      rel="${file#"$REPO_DIR"/"$pkg"/}"
      case "$rel" in
        .stow-local-ignore|*.example) continue ;;
      esac

      dest="$target/$rel"

      if [ -L "$dest" ]; then
        link_target="$(readlink -f "$dest")"
        case "$link_target" in
          "$REPO_DIR"/"$pkg"/*) : ;;
          *)
            echo "dot doctor: $dest resolves outside $REPO_DIR/$pkg (broken symlink)" >&2
            unresolved=$((unresolved + 1))
            broken_pkgs+=("$pkg")
            ;;
        esac
      elif [ -e "$dest" ]; then
        echo "dot doctor: $dest exists but is a real file, not a symlink -- not touching it (run 'dot stow $pkg' manually if intended)" >&2
        unresolved=$((unresolved + 1))
      else
        echo "dot doctor: $dest is missing (expected a symlink into $REPO_DIR/$pkg)" >&2
        unresolved=$((unresolved + 1))
        broken_pkgs+=("$pkg")
      fi
    done < <(find "$REPO_DIR/$pkg" -type f)
  done

  if [ "$fix" -eq 1 ] && [ "${#broken_pkgs[@]}" -gt 0 ]; then
    local seen=" " p
    for p in "${broken_pkgs[@]}"; do
      case "$seen" in
        *" $p "*) continue ;;
      esac
      seen="$seen$p "
      dot_stow "$p"
    done
    unresolved=$((unresolved - ${#broken_pkgs[@]}))
  fi

  if ! command -v brew >/dev/null 2>&1; then
    echo "dot: Homebrew not found. Run ./bootstrap.sh first." >&2
    exit 1
  fi

  local brew_output
  if brew_output="$(brew bundle check --verbose --file="$REPO_DIR/Brewfile" 2>&1)"; then
    :
  else
    echo "$brew_output" >&2
    echo "dot doctor: missing Brewfile-declared packages -- run 'dot update' to install missing packages" >&2
    unresolved=$((unresolved + 1))
  fi

  if [ "$unresolved" -gt 0 ]; then
    echo "dot doctor: $unresolved issue(s) found" >&2
    exit 1
  fi

  echo "dot doctor: all checks passed"
}

dot_help() {
  cat <<'EOF'
dot -- dotfiles management CLI

Usage: dot <command>

Commands:
  install     brew bundle + stow every package (run after ./bootstrap.sh)
  stow [pkg]  stow a single package (zsh, git, claude) or all if omitted
  update      git pull + brew bundle + restow (fails fast on dirty tree)
  doctor      report stow/Brewfile health (--fix re-stows broken symlinks)
  uninstall   not yet implemented (v2)
  help        show this message
EOF
}

case "${1:-help}" in
  install) shift; dot_install "$@" ;;
  stow)    shift; dot_stow "$@" ;;
  update)  shift; dot_update "$@" ;;
  uninstall)
    echo "dot $1: not yet implemented (v2)" >&2
    exit 1
    ;;
  doctor) shift; dot_doctor "$@" ;;
  help|--help|-h) dot_help ;;
  *)
    echo "dot: unknown subcommand '${1:-}'" >&2
    dot_help
    exit 1
    ;;
esac
